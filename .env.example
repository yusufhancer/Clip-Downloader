# Optional overrides; defaults below are used if omitted.
MAX_CLIP_DURATION=300
MAX_VIDEO_DURATION=14400
MAX_CONCURRENT_JOBS=2
FILE_TTL_SECONDS=3600
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# YT_DLP_PATH=C:/path/to/yt-dlp.exe
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
# MEDIA_TEMP_DIR=D:/web-downold/.clips
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
